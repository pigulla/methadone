{
    "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
    "workspaces": {
        "packages/dto": {
            "project": ["src/**/*.ts"],
            "ignore": ["dist/**"]
        },
        "packages/macos-notifier": {
            "project": ["src/**/*.ts"],
            "ignore": ["dist/**"],
            "ignoreBinaries": ["osascript"]
        },
        "packages/server": {
            "ignore": ["dist/**"],
            "ignoreDependencies": ["pino", "pino-pretty", "yaml"],
            "paths": {
                "#application/*": ["src/application/*"],
                "#domain/*": ["src/domain/*"],
                "#infrastructure/*": ["src/infrastructure/*"],
                "#module/*": ["src/module/*"],
                "#presentation/*": ["src/presentation/*"]
            }
        }
    },
    "ignoreDependencies": [
        "@swc-node/register",
        "cz-conventional-changelog",
        "source-map-support",
        "vite"
    ]
}
