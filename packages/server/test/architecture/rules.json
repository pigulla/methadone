{
    "application": [
        {
            "mustNotImportFrom": ["infrastructure", "module", "presentation"]
        }
    ],
    "domain": [
        {
            "mustNotImportFrom": ["application", "module", "presentation"]
        },
        {
            "mustNotImportFrom": "infrastructure",
            "ignoringErrorsIn": "src/domain/transactional.ts"
        }
    ],
    "presentation": [
        {
            "mustNotImportFrom": "module"
        },
        {
            "mustNotImportFrom": "application",
            "exceptFor": ["configs", "errors", "interfaces"]
        }
    ],
    "infrastructure": [
        {
            "mustNotImportFrom": ["module", "presentation"]
        },
        {
            "mustNotImportFrom": "application",
            "exceptFor": ["configs", "errors", "interfaces"]
        }
    ],
    "module": [],
    "util": [
        {
            "mustNotImportFrom": [
                "application",
                "domain",
                "infrastructure",
                "module",
                "presentation"
            ]
        }
    ]
}
