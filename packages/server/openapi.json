                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Get all channels of a network.",
                "tags": [
                    "network"
                ]
            }
        },
        "/networks/{networkKey}/channels/{channelKey}": {
            "get": {
                "description": "Get the channels with the given key for the given network, if it exists.",
                "operationId": "NetworkController_getChannelForNetwork",
                "parameters": [
                    {
                        "name": "channelKey",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": "trance",
                            "type": "string"
                        }
                    },
                    {
                        "name": "networkKey",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": "di",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "400": {
                        "description": "A query or route parameter, the payload or a header was malformed and did not pass validation."
                    },
                    "404": {
                        "description": "The network or channel with the given key was not found."
                    },
                    "500": {
                        "description": "An unexpected error occurred."
                    },
                    "default": {
                        "description": "The operation completed successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ChannelDTO_Output"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Get the channel with the given key.",
                "tags": [
                    "network"
                ]
            }
        },
