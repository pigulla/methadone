                "description": "Get all networks.",
                "operationId": "NetworkController_getAll",
                "parameters": [],
                "responses": {
                    "400": {
                        "description": "A query or route parameter, the payload or a header was malformed and did not pass validation."
                    },
                    "500": {
                        "description": "An unexpected error occurred."
                    },
                    "default": {
                        "description": "The operation completed successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/NetworkDTO_Output"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Get all networks.",
                "tags": [
                    "network"
                ]
            }
        },
        "/networks/{networkKey}": {
            "get": {
                "description": "Get the network with the given key, if it exists.",
                "operationId": "NetworkController_getOne",
                "parameters": [
                    {
                        "name": "networkKey",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": "di",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The operation completed successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NetworkDTO"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "A query or route parameter, the payload or a header was malformed and did not pass validation."
                    },
                    "404": {
                        "description": "The network with the given key was not found."
                    },
                    "500": {
                        "description": "An unexpected error occurred."
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Get a network by key.",
                "tags": [
                    "network"
                ]
            }
        },
        "/networks/{networkKey}/channels": {
            "get": {
                "description": "Get all channels of the network with the given key, if it exists.",
