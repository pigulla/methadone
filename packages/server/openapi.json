                            }
                        }
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Get track being streamed.",
                "tags": [
                    "stream"
                ]
            }
        },
        "/stream/{networkKey}/{channelKey}": {
            "get": {
                "description": "Start playback of the channel of the given network with the given key, if it exists. The stream is the raw audio without any IceCast metadata. Any previously started stream is terminated.",
                "operationId": "StreamController_play",
                "parameters": [
                    {
                        "name": "channelKey",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": "trance",
                            "type": "string"
                        }
                    },
                    {
                        "name": "networkKey",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "example": "di",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The operation completed successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "A query or route parameter, the payload or a header was malformed and did not pass validation."
                    },
                    "404": {
                        "description": "The channel with the given key was not found."
                    },
                    "500": {
                        "description": "An unexpected error occurred."
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Start streaming a channel.",
                "tags": [
                    "stream"
                ]
            }
        }
