        "/stream": {
            "delete": {
                "description": "Stop playback of the current stream (if any). Note that a client may continue playing until its local buffer is empty.",
                "operationId": "StreamController_stop",
                "parameters": [],
                "responses": {
                    "204": {
                        "description": ""
                    },
                    "400": {
                        "description": "A query or route parameter, the payload or a header was malformed and did not pass validation."
                    },
                    "500": {
                        "description": "An unexpected error occurred."
                    }
                },
                "security": [
                    {}
                ],
                "summary": "Stop playback.",
                "tags": [
                    "stream"
                ]
            },
            "get": {
                "description": "Get the track currently being streamed (if any).",
                "operationId": "StreamController_nowPlaying",
                "parameters": [],
                "responses": {
                    "400": {
                        "description": "A query or route parameter, the payload or a header was malformed and did not pass validation."
                    },
                    "404": {
                        "description": "No channel is currently being streamed."
                    },
                    "500": {
                        "description": "An unexpected error occurred."
                    },
                    "default": {
                        "description": "The operation completed successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
