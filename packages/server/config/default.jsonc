{
    "server": {
        "hostname": "localhost",
        "port": 3000,
        "apiKey": false,
        "enableCors": true
    },
    "logging": {
        "enabled": true,
        "pretty": false,
        "level": "log",
        "requestResponse": false
    },
    "openApi": {
        "server": "http://example.com",
        "title": "Methadone API",
        "description": "This is the Methadone HTTP API.",
        "version": "1.0",
        "swagger": {
            "enabled": false,
            "path": "swagger"
        },
        "license": {
            "name": "ISC",
            "url": "https://spdx.org/licenses/ISC"
        },
        "contact": {
            "name": "Raphael Pigulla",
            "email": "raphael@pigulla.net",
            "url": "https://de.linkedin.com/in/pigulla"
        }
    },
    "audioAddict": {
        "baseUrl": "https://api.audioaddict.com",
        "listeningKey": "",
        "format": "mp3-320",
        "useCache": true,
        "currentlyPlayingRefreshIntervalInSeconds": 15
    },
    "externalPlayer": {
        "path": "",
        "options": []
    },
    "application": {
        "heartbeatIntervalInSeconds": 15
    }
}
